{
  "name": "pi-cmd-palette",
  "version": "0.1.0",
  "description": "Pi command palette: list/read/run slash commands, prompts, and skills with fuzzy search over name/description/content.",
  "author": "buihongduc132",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buihongduc132/pi-cmd-palette.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "command-palette",
    "fuzzy-search"
  ],
  "files": [
    "extensions/**/*.ts",
    "skills/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run test:coverage",
    "smoke-test": "node --experimental-strip-types scripts/smoke-test.ts",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "vitest": "^3.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.8.0"
  }
}
